fizzbuzz := (number: int) -> string|int {
    if number%15==0 {
        return "FizzBuzz";
    }
    if number%3==0 {
        return "Fizz";
    }
    if number%5==0 {
        return "Buzz";
    }
    return number;
};

/*
Returns iterator of values from start to end
*/
iota := (start: int, end: int) -> () -> (#Some(int)|#None) {
    i:=mut start;
    return () -> #Some(int)|#None {
        result := *i;
        if(result > end) {
            return #None;
        }
        i+=1;
        return #Some(result);
    }
};

iota(1, 15) @ fizzbuzz @ std.io.print $];